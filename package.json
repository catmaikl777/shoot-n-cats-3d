{
  "name": "shoot-n-cats-3d",
  "version": "1.0.0",
  "description": "Shoot'n'cats 3D — браузерный 3D-шутер от третьего лица на Three.js + Rapier + Photon Realtime",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host",
    "dev:https": "node ./node_modules/vite/bin/vite.js --host",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host",
    "smoke": "node ./scripts/smoke.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.18.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
